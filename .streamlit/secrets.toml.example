# Copy this file to .streamlit/secrets.toml and fill in real values.
# .streamlit/secrets.toml is gitignored — never commit the real file.
#
# On Streamlit Community Cloud: paste these into the app's "Secrets"
# settings UI (App settings → Secrets) instead of committing them.

# ── Task Tracker (Team Tasks / Team Members in the Tasks Overflow base) ──────
# Base: appn5Hubzzo595VwZ. Override TASKS_BASE_ID/TASKS_TABLE_ID/MEMBERS_TABLE_ID
# below only if you need to point at different tables — the defaults in
# task_store.py already match this base's "Team Tasks"/"Team Members" tables.
AIRTABLE_TOKEN = "patXXXXXXXXXXXX.YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY"
# TASKS_BASE_ID    = "appn5Hubzzo595VwZ"
# TASKS_TABLE_ID   = "tblW5gzXUzeZcMEHq"
# MEMBERS_TABLE_ID = "tblZ1ByP7AhaLUWWU"

# ── Onboarding Automation ────────────────────────────────────────────────────
# Airtable PAT with access to Base 1 (appbXFzZnhij88tnQ) and Base 2 (appoDQDrqyvyPsZTY)
AIRTABLE_API_KEY = "patXXXXXXXXXXXX.YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY"

# Twilio credentials
TWILIO_ACCOUNT_SID      = "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN       = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_TEMPLATE_FLOW_SID = "FWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# JotForm
JOTFORM_API_KEY          = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
REVIEW_FORM_TEMPLATE_ID  = "250925621600045"

# Google Places API
GOOGLE_API_KEY = "AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ── Zap Audit (Supabase) ─────────────────────────────────────────────────────
# anon/public key only — read-only, enforced by the zap_runs RLS policy.
# Never put the service_role/secret key here; it belongs only in the Zapier
# Logger zap's webhook headers.
supabase_url = "https://xxxxxxxxxxxx.supabase.co"
supabase_key = "sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX"
